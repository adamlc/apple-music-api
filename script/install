#!/bin/bash
# Builds the app, installs it to ~/Applications and (re)starts it.
#
# Turn on "Start at Login" from the menu bar item once it is running from here, so the login item
# points at this copy rather than the build folder.
set -euo pipefail
cd "$(dirname "$0")/.."

NAME="Apple Music API"
BUNDLE_ID="uk.co.adamlc.apple-music-api"
DEST="$HOME/Applications/$NAME.app"

script/bundle

# Quit any running copy (installed or from build/) so the new one can take over the port.
if pgrep -f "$NAME.app/Contents/MacOS" >/dev/null; then
  osascript -e "tell application id \"$BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
  for _ in {1..20}; do
    pgrep -f "$NAME.app/Contents/MacOS" >/dev/null || break
    sleep 0.25
  done
  pkill -f "$NAME.app/Contents/MacOS" 2>/dev/null || true
fi

mkdir -p "$HOME/Applications"
rm -rf "$DEST"
ditto "build/$NAME.app" "$DEST"

# LaunchServices can still be tearing down the old instance for a moment, which makes `open` fail
# (error -600), so retry briefly.
for _ in {1..10}; do
  open "$DEST" && break
  sleep 1
done
echo "Installed and started $DEST"
